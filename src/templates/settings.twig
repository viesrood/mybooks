{% import '_includes/forms.twig' as forms %}

{% macro overrideWarning(overrides, setting) %}
    {% if setting in overrides %}
        {{ 'This is being overridden by the {setting} setting in config/mybooks.php.'|t('mybooks', { setting: '<code>' ~ setting ~ '</code>' })|raw }}
    {% endif %}
{% endmacro %}

<p>{{ 'Every setting below can also be set per environment in config/mybooks.php. Books are added with a Books field; linked accounts are listed under Utilities → My Books.'|t('mybooks') }}</p>

<h2>{{ 'Covers'|t('mybooks') }}</h2>

{{ forms.selectField({
    label: 'Cover volume'|t('mybooks'),
    instructions: 'Where downloaded covers are stored. Recommended: without a volume, covers are linked from Open Library, so every visitor’s browser contacts Open Library.'|t('mybooks'),
    id: 'coverVolume',
    name: 'coverVolume',
    options: volumeOptions,
    value: settings.coverVolume ?? '',
    warning: _self.overrideWarning(overrides, 'coverVolume'),
    errors: settings.getErrors('coverVolume'),
}) }}

{{ forms.textField({
    label: 'Cover folder'|t('mybooks'),
    instructions: 'Folder inside the volume. Leave empty for the root.'|t('mybooks'),
    id: 'coverSubpath',
    name: 'coverSubpath',
    class: 'code',
    value: settings.coverSubpath,
    warning: _self.overrideWarning(overrides, 'coverSubpath'),
    errors: settings.getErrors('coverSubpath'),
}) }}

{{ forms.textField({
    label: 'Covers per sync'|t('mybooks'),
    instructions: 'The most covers downloaded per account in one sync run. A large library is completed over a few runs.'|t('mybooks'),
    id: 'maxCoverDownloadsPerSync',
    name: 'maxCoverDownloadsPerSync',
    type: 'number',
    min: 0,
    max: 500,
    size: 5,
    value: settings.maxCoverDownloadsPerSync,
    warning: _self.overrideWarning(overrides, 'maxCoverDownloadsPerSync'),
    errors: settings.getErrors('maxCoverDownloadsPerSync'),
}) }}

<h2>{{ 'Sync'|t('mybooks') }}</h2>

{{ forms.textField({
    label: 'Books per shelf'|t('mybooks'),
    instructions: 'The most books kept per shelf of a linked account, newest first.'|t('mybooks'),
    id: 'maxBooksPerShelf',
    name: 'maxBooksPerShelf',
    type: 'number',
    min: 1,
    max: 500,
    size: 5,
    value: settings.maxBooksPerShelf,
    warning: _self.overrideWarning(overrides, 'maxBooksPerShelf'),
    errors: settings.getErrors('maxBooksPerShelf'),
}) }}

{{ forms.textField({
    label: 'Timeout'|t('mybooks'),
    instructions: 'Seconds before a request to Open Library is given up.'|t('mybooks'),
    id: 'timeout',
    name: 'timeout',
    type: 'number',
    min: 1,
    max: 60,
    size: 3,
    unit: 's',
    value: settings.timeout,
    warning: _self.overrideWarning(overrides, 'timeout'),
    errors: settings.getErrors('timeout'),
}) }}

<p class="light">
    {{ 'Linked accounts are synced right after an entry links them, from the “Sync now” buttons, and by a cron job:'|t('mybooks') }}
    <code>php craft mybooks/sync</code>
</p>
