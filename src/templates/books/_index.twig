{% extends '_layouts/cp' %}

{% set title = 'Books of {name}'|t('mybooks', { name: reader.name }) %}
{% set crumbs = [
    { label: 'My Books'|t('mybooks'), url: url('mybooks') },
] %}

{% block actionButton %}
    {% if editable %}
        <a href="{{ url('mybooks/readers/' ~ reader.id ~ '/books/new') }}" class="btn submit add icon">{{ 'New book'|t('mybooks') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if not editable %}
        <p class="light">
            {{ 'These books come from {provider} and are refreshed by every sync. Change them there.'|t('mybooks', { provider: reader.providerInstance ? reader.providerInstance.displayName() : reader.provider }) }}
        </p>
    {% endif %}

    <p id="mybooks-nobooks" class="zilch{% if books|length %} hidden{% endif %}">{{ 'No books yet'|t('mybooks') }}</p>

    {% for option in craft.mybooks.shelves() %}
        {% set shelfBooks = books|filter(b => b.shelf.value == option.value) %}
        {% if shelfBooks|length %}
            <h2>{{ option.label }} <span class="light">({{ shelfBooks|length }})</span></h2>
            <div class="tablepane" style="margin-bottom: 24px;">
                <table class="data fullwidth mybooks-books" data-shelf="{{ option.value }}">
                    <thead>
                        <tr>
                            <td class="thin"></td>
                            <th scope="col">{{ 'Title'|t('mybooks') }}</th>
                            <th scope="col">{{ 'Authors'|t('mybooks') }}</th>
                            {% if option.value == 'reading' %}<th scope="col">{{ 'Progress'|t('mybooks') }}</th>{% endif %}
                            {% if option.value == 'read' %}<th scope="col">{{ 'Finished'|t('mybooks') }}</th>{% endif %}
                            <th scope="col">{{ 'Cover'|t('mybooks') }}</th>
                            {% if editable %}
                                <td class="thin"></td>
                                <td class="thin"></td>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for book in shelfBooks %}
                            <tr data-id="{{ book.id }}" data-name="{{ book.title }}">
                                <td class="thin">
                                    {% set src = book.getCoverSrc() %}
                                    {% if src %}
                                        <img src="{{ src }}" alt="" width="30" height="45" loading="lazy" style="display: block; width: 30px; height: 45px; object-fit: cover; border-radius: 2px;">
                                    {% endif %}
                                </td>
                                <th scope="row" data-title="{{ 'Title'|t('mybooks') }}">
                                    {% if editable %}
                                        <a href="{{ url('mybooks/readers/' ~ reader.id ~ '/books/' ~ book.id) }}">{{ book.title }}</a>
                                    {% elseif book.url %}
                                        <a href="{{ book.url }}" target="_blank" rel="noopener">{{ book.title }}</a>
                                    {% else %}
                                        {{ book.title }}
                                    {% endif %}
                                    {% if book.subtitle %}<div class="light smalltext">{{ book.subtitle }}</div>{% endif %}
                                </th>
                                <td data-title="{{ 'Authors'|t('mybooks') }}">{{ book.authorsString }}</td>
                                {% if option.value == 'reading' %}
                                    <td data-title="{{ 'Progress'|t('mybooks') }}">{{ book.progress is not null ? book.progress ~ '%' : '' }}</td>
                                {% endif %}
                                {% if option.value == 'read' %}
                                    <td data-title="{{ 'Finished'|t('mybooks') }}">{{ book.finishedDate ? book.finishedDate|date('short') : '' }}</td>
                                {% endif %}
                                <td data-title="{{ 'Cover'|t('mybooks') }}">
                                    {% if book.cover %}
                                        <span class="light">{{ 'Stored locally'|t('mybooks') }}</span>
                                    {% elseif book.coverUrl %}
                                        <span class="light">{{ 'Linked from the book service'|t('mybooks') }}</span>
                                    {% else %}
                                        <span class="light">{{ 'None'|t('mybooks') }}</span>
                                    {% endif %}
                                </td>
                                {% if editable %}
                                    <td class="thin"><a class="move icon" title="{{ 'Reorder'|t('mybooks') }}" aria-label="{{ 'Reorder'|t('mybooks') }}" role="button"></a></td>
                                    <td class="thin"><a class="delete icon" title="{{ 'Delete'|t('mybooks') }}" aria-label="{{ 'Delete'|t('mybooks') }}" role="button"></a></td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}

{% if editable %}
    {% js %}
        document.querySelectorAll('.mybooks-books').forEach((table) => {
            new Craft.AdminTable({
                tableSelector: table,
                noItemsSelector: '#mybooks-nobooks',
                sortable: true,
                allowDeleteAll: true,
                reorderAction: 'mybooks/books/reorder',
                deleteAction: 'mybooks/books/delete',
                confirmDeleteMessage: {{ 'Delete “{name}”?'|t('mybooks')|json_encode|raw }},
            });
        });
    {% endjs %}
{% endif %}
